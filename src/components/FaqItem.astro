---
/**
 * Zero-JS accordion built on native <details>/<summary> — keyboard and
 * screen-reader support come from the browser, no client script required.
 */
interface Props {
  question: string;
  class?: string;
}

const { question, class: className } = Astro.props;
---

<details class:list={["faq-item", className]}>
  <summary class="faq-item-summary">
    <span class="h6">{question}</span>
    <span class="faq-item-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </span>
  </summary>
  <div class="faq-item-answer">
    <slot />
  </div>
</details>

<style>
  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
  }

  .faq-item-summary::-webkit-details-marker {
    display: none;
  }

  .faq-item-summary .h6 {
    margin: 0;
  }

  .faq-item-icon {
    display: inline-flex;
    color: var(--color-graphite);
    flex-shrink: 0;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .faq-item[open] .faq-item-icon {
    transform: rotate(180deg);
  }

  .faq-item-answer {
    padding-bottom: 1.25rem;
    color: var(--color-muted);
    max-width: var(--container-prose);
  }
</style>
