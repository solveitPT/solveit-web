---
/**
 * Curated line-icon set — 24px grid, ~1.6px stroke, rounded caps/joins.
 * Deliberately avoids IT clichés per BRAND_IDENTITY.md §6: no padlock/shield for
 * security, no server for cloud, no floppy disk for backup, no headset for support.
 */
export type IconName =
  | "security"
  | "cloud"
  | "backup"
  | "support"
  | "network"
  | "consulting"
  | "chevron-down"
  | "menu"
  | "close"
  | "arrow-right"
  | "check"
  | "mail"
  | "phone";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  "stroke-width"?: number;
}

const {
  name,
  size = 24,
  class: className,
  "stroke-width": strokeWidth = 1.6,
} = Astro.props;

const inner: Record<IconName, string> = {
  security: `<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9"/>`,
  cloud: `<path d="M7 17h10a3.5 3.5 0 0 0 0-7 5 5 0 0 0-9.6-1.6A4 4 0 0 0 7 17z"/>`,
  backup: `<path d="M4 12a8 8 0 0 1 13.7-5.7M20 12a8 8 0 0 1-13.7 5.7"/><path d="M17 4v3h-3M7 20v-3h3"/>`,
  support: `<circle cx="8" cy="12" r="3.2"/><circle cx="16" cy="12" r="3.2"/>`,
  network: `<path d="M4 15a11 11 0 0 1 16 0M7.5 18.2a6 6 0 0 1 9 0"/><circle cx="12" cy="20.5" r="1" fill="currentColor" stroke="none"/>`,
  consulting: `<circle cx="6" cy="18" r="1.6"/><circle cx="18" cy="6" r="1.6"/><path d="M7.2 16.8C10 12 14 10 16.8 7.2"/>`,
  "chevron-down": `<path d="M6 9l6 6 6-6"/>`,
  menu: `<path d="M4 7h16M4 12h16M4 17h16"/>`,
  close: `<path d="M6 6l12 12M18 6L6 18"/>`,
  "arrow-right": `<path d="M4 12h14M13 6l6 6-6 6"/>`,
  check: `<path d="M5 12.5l4.5 4.5L19 7"/>`,
  mail: `<path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/>`,
  phone: `<path d="M7 4h3l1.5 4-2 1.5a12 12 0 0 0 5 5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 5 6.2 2 2 0 0 1 7 4z"/>`,
};
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner[name]}
/>

<style>
  .icon {
    flex-shrink: 0;
  }
</style>
