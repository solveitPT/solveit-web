---
interface Props {
  tone?: "amber" | "graphite";
  class?: string;
}

const { tone = "amber", class: className } = Astro.props;
---

<span class:list={["badge", `badge--${tone}`, className]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    line-height: 1.4;
  }

  .badge--amber {
    background: var(--color-amber);
    color: var(--color-graphite);
  }

  .badge--graphite {
    background: transparent;
    color: var(--color-graphite);
    border: 1px solid var(--color-graphite);
  }
</style>
