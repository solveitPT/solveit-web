---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Icon from "../../components/Icon.astro";
import FaqItem from "../../components/FaqItem.astro";
import CtaSection from "../../components/CtaSection.astro";
import FormGroup from "../../components/form/FormGroup.astro";
import Input from "../../components/form/Input.astro";
import Textarea from "../../components/form/Textarea.astro";
import apImage from "../../assets/images/office/wall-access-point.jpg";

const problems = [
  "Há zonas do escritório onde o Wi-Fi simplesmente não chega.",
  "A rede fica lenta sempre que há mais do que umas pessoas ligadas.",
  "Um equipamento de rede antigo cai sem motivo aparente.",
  "A empresa cresceu, mas a rede continua a mesma de há anos.",
];

const scopeGroups = [
  { title: "Desenho da rede", description: "Planeamento adaptado ao espaço e ao número de pessoas/equipamentos." },
  { title: "Equipamento", description: "Routers, switches e access points escolhidos para a sua empresa." },
  { title: "Cobertura Wi-Fi", description: "Ligação estável em todo o espaço relevante, sem zonas mortas." },
  { title: "Separação de redes", description: "Redes distintas para finalidades diferentes (por exemplo, uma rede só para visitantes), quando fizer sentido." },
];

const steps = [
  { title: "Avaliamos o espaço", description: "Onde a rede falha hoje, e porquê." },
  { title: "Desenhamos a solução", description: "Equipamento e disposição certos para o seu espaço." },
  { title: "Instalamos e configuramos", description: "" },
  { title: "Testamos", description: "Confirmamos que a cobertura corresponde ao que foi planeado para o seu espaço." },
];

const faqs = [
  { question: "Como sei se preciso disto?", answer: "Se há zonas sem Wi-Fi, quedas frequentes, ou a rede não aguenta o número de pessoas ligadas, vale a pena avaliar. Começamos sempre por perceber a situação atual." },
  { question: "Trabalham só com Wi-Fi ou também com rede cablada?", answer: "As duas — a solução certa depende do espaço e da forma como a sua empresa trabalha." },
  { question: "Conseguem garantir cobertura em todo o escritório?", answer: "Desenhamos a solução para cobrir todo o espaço relevante para o seu negócio — em espaços com desafios estruturais, avaliamos caso a caso a melhor abordagem." },
  { question: "Isto só faz sentido para escritórios grandes?", answer: "Faz sentido em qualquer tamanho — mesmo uma rede pequena beneficia de estar bem desenhada, principalmente à medida que a empresa cresce." },
  { question: "Quanto tempo demora a instalação?", answer: "Depende da dimensão do espaço e da solução necessária — definimos um prazo claro depois de avaliarmos o seu caso." },
];
---

<BaseLayout
  title="Redes e Wi-Fi para Empresas"
  description="Desenho, instalação e configuração de redes e Wi-Fi para a sua empresa — cobertura estável, sem zonas mortas nem quedas inexplicáveis."
>
  <section class="hero">
    <div class="container-content hero-layout">
      <div class="hero-text">
        <a href="/servicos" class="breadcrumb">Serviços</a>
        <h1>Uma rede que aguenta o seu negócio, não só o dia de hoje.</h1>
        <p class="hero-sub body-lg">
          Desenho, instalação e configuração de redes e Wi-Fi para a sua empresa — sem zonas mortas, sem quedas
          inexplicáveis.
        </p>
        <div class="hero-actions">
          <Button href="#contacto" variant="primary">Marcar uma conversa</Button>
          <Button href="#o-que-tratamos" variant="secondary">Ver o que tratamos</Button>
        </div>
      </div>
      <div class="hero-image-wrap">
        <Image
          src={apImage}
          alt="Access point Wi-Fi discreto montado numa parede de escritório."
          class="hero-image"
          widths={[350, 500, 700]}
          sizes="(min-width: 1024px) 22rem, (min-width: 768px) 30vw, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="Os sinais de uma rede mal dimensionada." />
      <ul class="problem-list">
        {problems.map((p) => <li>{p}</li>)}
      </ul>
      <p class="problem-close">Uma rede bem desenhada não se nota — só se nota quando falha.</p>
    </div>
  </section>

  <section class="section" id="o-que-tratamos">
    <div class="container-content">
      <SectionHeading heading="O que tratamos." />
      <div class="scope-grid">
        {
          scopeGroups.map((g) => (
            <div class="scope-group">
              <h3>{g.title}</h3>
              <p>{g.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="Como funciona." />
      <ol class="steps-list">
        {
          steps.map((s, i) => (
            <li>
              <span class="steps-number">{String(i + 1).padStart(2, "0")}</span>
              <span>
                <strong>{s.title}</strong>
                {s.description && <> — {s.description}</>}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="Ligação à segurança da sua empresa." />
      <p class="statement-body body-lg">
        Uma rede bem desenhada é também uma rede mais segura — menos pontos de entrada desnecessários, acessos
        separados quando faz sentido. Ver também <a href="/servicos/seguranca">Segurança</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="Pontual ou acompanhamento contínuo." />
      <div class="modes-grid">
        <div class="mode-block">
          <h3>Pontual</h3>
          <p>Desenho e instalação de uma rede nova, ou correção de um problema específico, sem compromisso continuado.</p>
        </div>
        <div class="mode-block">
          <h3>Avença</h3>
          <p>Manutenção e acompanhamento contínuo da rede da sua empresa, como parte da sua informática gerida.</p>
        </div>
      </div>
      <a href="/solucoes" class="mode-link">
        Conhecer a avença
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="Perguntas frequentes." />
      <div class="faq-list">
        {
          faqs.map((f) => (
            <FaqItem question={f.question}>
              <p>{f.answer}</p>
            </FaqItem>
          ))
        }
      </div>
      <p class="faq-close">
        Ainda tem dúvidas? <a href="#contacto" class="faq-close-link">Fale connosco</a>.
      </p>
    </div>
  </section>

  <section id="contacto">
    <CtaSection subheading="Descreva a sua situação atual — remoto em todo o país, presencial na Grande Lisboa e Margem Sul do Tejo." tone="graphite">
      <Fragment slot="heading">Vamos desenhar a sua rede.</Fragment>
      <form class="contact-form" method="post">
        <div class="contact-form-row">
          <FormGroup label="Nome" for="n-name" required>
            <Input id="n-name" name="name" required />
          </FormGroup>
          <FormGroup label="Empresa" for="n-company" required>
            <Input id="n-company" name="company" required />
          </FormGroup>
        </div>
        <div class="contact-form-row">
          <FormGroup label="Email" for="n-email" required>
            <Input id="n-email" name="email" type="email" required />
          </FormGroup>
          <FormGroup label="Telefone" for="n-phone">
            <Input id="n-phone" name="phone" type="tel" />
          </FormGroup>
        </div>
        <FormGroup label="Mensagem" for="n-message">
          <Textarea id="n-message" name="message" rows={4} />
        </FormGroup>
        <Button type="submit" variant="primary">Fale connosco</Button>
      </form>
    </CtaSection>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(3rem, 2.2rem + 3vw, 5.5rem); }
  .hero-layout { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
  @media (min-width: 768px) { .hero-layout { grid-template-columns: 1.6fr 1fr; gap: 3.5rem; } }
  @media (min-width: 1024px) { .hero-layout { grid-template-columns: 2fr 1fr; } }
  .hero-text { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; max-width: 40rem; }
  .breadcrumb { font-family: var(--font-body); font-weight: 600; font-size: 0.8125rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-muted); }
  .breadcrumb:hover { color: var(--color-amber-hover); }
  .hero-sub { color: var(--color-muted); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.875rem; margin-top: 0.5rem; }
  .hero-image-wrap { justify-self: end; width: 100%; max-width: 22rem; }
  .hero-image { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-md); }

  .section { padding-block: clamp(3rem, 2.2rem + 3vw, 5.5rem); border-top: 1px solid var(--color-border); }
  .section-narrow { max-width: 56rem; }
  .section :global(.section-heading) { margin-bottom: 2rem; }

  .problem-list { display: flex; flex-direction: column; gap: 0.875rem; font-size: 1.0625rem; color: var(--color-text); }
  .problem-list li { padding-left: 1.25rem; position: relative; }
  .problem-list li::before { content: "—"; position: absolute; left: 0; color: var(--color-secondary); }
  .problem-close { margin-top: 1.5rem; font-family: var(--font-heading); font-weight: 700; font-size: 1.125rem; }

  .scope-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  @media (min-width: 640px) { .scope-grid { grid-template-columns: 1fr 1fr; gap: 2.5rem 2rem; } }
  .scope-group h3 { margin-bottom: 0.5rem; }
  .scope-group p { color: var(--color-muted); font-size: 0.9375rem; }

  .steps-list { display: flex; flex-direction: column; gap: 1.25rem; }
  .steps-list li { display: flex; gap: 1rem; align-items: baseline; }
  .steps-number { font-family: ui-monospace, "SFMono-Regular", Consolas, monospace; font-size: 0.875rem; color: var(--color-amber-hover); flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .steps-list strong { font-family: var(--font-heading); }

  .statement-body { color: var(--color-muted); max-width: var(--container-prose); }
  .statement-body :global(a) { color: var(--color-graphite); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .statement-body :global(a:hover) { color: var(--color-amber-hover); }

  .modes-grid { display: grid; grid-template-columns: 1fr; gap: 1.75rem; margin-bottom: 1.5rem; }
  @media (min-width: 640px) { .modes-grid { grid-template-columns: 1fr 1fr; gap: 2.5rem; } }
  .mode-block h3 { margin-bottom: 0.5rem; }
  .mode-block p { color: var(--color-muted); }
  .mode-link { display: inline-flex; align-items: center; gap: 0.375rem; font-family: var(--font-heading); font-weight: 600; font-size: 0.9375rem; color: var(--color-graphite); transition: gap var(--duration-base) var(--ease-standard); }
  .mode-link:hover { gap: 0.625rem; color: var(--color-amber-hover); }

  .faq-close { margin-top: 1.5rem; color: var(--color-muted); }
  .faq-close-link { color: var(--color-graphite); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .faq-close-link:hover { color: var(--color-amber-hover); }

  .contact-form { display: flex; flex-direction: column; gap: 1.125rem; text-align: left; }
  .contact-form-row { display: grid; grid-template-columns: 1fr; gap: 1.125rem; }
  @media (min-width: 640px) { .contact-form-row { grid-template-columns: 1fr 1fr; } }
  .contact-form :global(.form-label) { color: var(--color-surface); }
  .contact-form :global(.form-hint) { color: color-mix(in srgb, var(--color-surface) 65%, transparent); }
</style>
