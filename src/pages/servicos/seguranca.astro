---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Icon from "../../components/Icon.astro";
import FaqItem from "../../components/FaqItem.astro";
import CtaSection from "../../components/CtaSection.astro";
import FormGroup from "../../components/form/FormGroup.astro";
import Input from "../../components/form/Input.astro";
import Textarea from "../../components/form/Textarea.astro";
import laptopImage from "../../assets/images/office/laptop-security-key-desk.jpg";

const risks = [
  "Uma password fraca ou reutilizada dá acesso a mais do que imagina.",
  "Um email de phishing engana um colaborador distraído — pode acontecer a qualquer um.",
  "Um computador sem atualizações há meses fica exposto a falhas já conhecidas.",
  "Um colaborador que já saiu da empresa ainda tem acesso a sistemas importantes.",
  "Ninguém sabe o que fazer nos primeiros minutos depois de um incidente.",
];

const scopeGroups = [
  { title: "Contas e acessos", description: "Passwords fortes, remoção de acessos que já não deviam existir. Recomendamos e implementamos autenticação multifator sempre que o sistema em causa a suportar." },
  { title: "Equipamento", description: "Atualizações e correções de segurança em computadores e servidores." },
  { title: "Email e comunicação", description: "Configuração e boas práticas para reduzir o risco de phishing e tentativas de fraude." },
  { title: "Preparação para incidentes", description: "Saber o que fazer quando algo acontece, e a quem recorrer quando é preciso apoio mais especializado." },
];

const measures = [
  "Passwords fortes, com autenticação multifator recomendada e implementada sempre que o sistema a suportar.",
  "Atualizações e correções de segurança aplicadas com regularidade.",
  "Gestão de acessos — só quem precisa, tem acesso.",
  "Redução do risco de malware e tentativas de phishing.",
];

const triad = [
  { title: "Prevenção", description: "Reduzir o risco antes de acontecer: passwords, atualizações, acessos corretos." },
  { title: "Deteção", description: "Monitorização e medidas de proteção adequadas ao cenário de cada empresa, para perceber quando algo foge do normal." },
  { title: "Resposta", description: "Agir rapidamente quando algo acontece, para limitar o impacto." },
];

const faqs = [
  {
    question: "Só preciso de um bom antivírus, certo?",
    answer: "Um antivírus é só uma parte. Segurança informática também é sobre passwords fortes, atualizações em dia, controlo de quem tem acesso a quê, e saber o que fazer se algo correr mal.",
  },
  {
    question: "A minha empresa é pequena — porque seria um alvo?",
    answer: "Empresas pequenas são muitas vezes alvo exatamente por não terem estas proteções em prática — não por serem menos visadas.",
  },
  {
    question: "Conseguem garantir que nunca seremos atacados?",
    answer: "Não — ninguém consegue garantir isso, e convém desconfiar de quem promete. O que fazemos é reduzir significativamente o risco, e preparar a sua empresa para reagir rapidamente se algo acontecer.",
  },
  {
    question: "O que é autenticação multifator (MFA) e preciso disso?",
    answer: "É um passo extra de confirmação (por exemplo, uma notificação no telemóvel) além da password. Reduz muito o risco de uma conta ser invadida mesmo que a password seja descoberta. Recomendamos e implementamos MFA sempre que o sistema em causa o suportar.",
  },
  {
    question: "Como começo, se não sei por onde a minha empresa está exposta?",
    answer: "Começamos por avaliar a situação atual — não precisa de saber onde estão os riscos antes de nos contactar, é precisamente isso que fazemos primeiro.",
  },
];
---

<BaseLayout
  title="Segurança Informática para Empresas"
  description="Redução do risco de acessos indevidos, phishing e falhas de segurança — proteção prática para pequenas e médias empresas, sem jargão técnico."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container-content hero-layout">
      <div class="hero-text">
        <a href="/servicos" class="breadcrumb">Serviços</a>
        <h1>Proteger a sua empresa começa antes do problema acontecer.</h1>
        <p class="hero-sub body-lg">
          Segurança informática não é só ter um antivírus instalado. É reduzir o risco de acessos indevidos, dados
          comprometidos e paragens inesperadas — de forma simples, sem alarido.
        </p>
        <div class="hero-actions">
          <Button href="#contacto" variant="primary">Marcar uma conversa</Button>
          <Button href="#o-que-protegemos" variant="secondary">Ver o que protegemos</Button>
        </div>
      </div>
      <div class="hero-image-wrap">
        <Image
          src={laptopImage}
          alt="Portátil numa secretária calma, com uma chave de segurança USB ao lado."
          class="hero-image"
          widths={[350, 500, 700]}
          sizes="(min-width: 1024px) 22rem, (min-width: 768px) 30vw, 100vw"
        />
      </div>
    </div>
  </section>

  <!-- Os riscos reais para uma PME -->
  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="Os riscos reais para uma PME." />
      <ul class="problem-list">
        {risks.map((r) => <li>{r}</li>)}
      </ul>
      <p class="problem-close">Estes riscos não escolhem o tamanho da empresa.</p>
    </div>
  </section>

  <!-- O que protegemos -->
  <section class="section" id="o-que-protegemos">
    <div class="container-content">
      <SectionHeading heading="O que protegemos." />
      <div class="scope-grid">
        {
          scopeGroups.map((g) => (
            <div class="scope-group">
              <h3>{g.title}</h3>
              <p>{g.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Medidas de segurança -->
  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="Medidas de segurança." />
      <ul class="check-list">
        {
          measures.map((m) => (
            <li>
              <Icon name="check" size={18} />
              <span>{m}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Prevenção, deteção e resposta -->
  <section class="section">
    <div class="container-content">
      <SectionHeading heading="Prevenção, deteção e resposta." />
      <div class="triad-grid">
        {
          triad.map((t) => (
            <div class="triad-block">
              <h3>{t.title}</h3>
              <p>{t.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- O que acontece perante um incidente -->
  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="O que acontece perante um incidente." />
      <p class="statement-body body-lg">
        Se suspeitar de um incidente de segurança, o primeiro passo é sempre contactar-nos. Avaliamos a situação,
        ajudamos a conter o problema, e coordenamos os passos necessários para a recuperação. Quando são precisas
        ferramentas ou competências mais especializadas, recorremos a parceiros adequados para o caso.
      </p>
    </div>
  </section>

  <!-- Pontual ou acompanhamento contínuo -->
  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="Pontual ou acompanhamento contínuo." />
      <div class="modes-grid">
        <div class="mode-block">
          <h3>Pontual</h3>
          <p>Correção de uma situação específica — um acesso a remover, um equipamento a atualizar — sem compromisso continuado.</p>
        </div>
        <div class="mode-block">
          <h3>Avença</h3>
          <p>Gestão contínua de segurança, como parte do acompanhamento regular da sua informática, para reduzir o risco de forma constante, não só quando há um problema.</p>
        </div>
      </div>
      <a href="/solucoes" class="mode-link">
        Conhecer a avença
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="Perguntas frequentes." />
      <div class="faq-list">
        {
          faqs.map((f) => (
            <FaqItem question={f.question}>
              <p>{f.answer}</p>
            </FaqItem>
          ))
        }
      </div>
      <p class="faq-close">
        Ainda tem dúvidas? <a href="#contacto" class="faq-close-link">Fale connosco</a>.
      </p>
    </div>
  </section>

  <!-- CTA final -->
  <section id="contacto">
    <CtaSection subheading="Descreva a sua situação atual — remoto em todo o país, presencial na Grande Lisboa e Margem Sul do Tejo." tone="graphite">
      <Fragment slot="heading">Vamos reduzir o seu risco.</Fragment>
      <form class="contact-form" method="post">
        <div class="contact-form-row">
          <FormGroup label="Nome" for="sec-name" required>
            <Input id="sec-name" name="name" required />
          </FormGroup>
          <FormGroup label="Empresa" for="sec-company" required>
            <Input id="sec-company" name="company" required />
          </FormGroup>
        </div>
        <div class="contact-form-row">
          <FormGroup label="Email" for="sec-email" required>
            <Input id="sec-email" name="email" type="email" required />
          </FormGroup>
          <FormGroup label="Telefone" for="sec-phone">
            <Input id="sec-phone" name="phone" type="tel" />
          </FormGroup>
        </div>
        <FormGroup label="Mensagem" for="sec-message">
          <Textarea id="sec-message" name="message" rows={4} />
        </FormGroup>
        <Button type="submit" variant="primary">Fale connosco</Button>
      </form>
    </CtaSection>
  </section>
</BaseLayout>

<style>
  /* ============ Hero (with image) ============ */
  .hero {
    padding-block: clamp(3rem, 2.2rem + 3vw, 5.5rem);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero-layout {
      grid-template-columns: 1.6fr 1fr;
      gap: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-layout {
      grid-template-columns: 2fr 1fr;
    }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 40rem;
  }

  .breadcrumb {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .breadcrumb:hover {
    color: var(--color-amber-hover);
  }

  .hero-sub {
    color: var(--color-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 0.5rem;
  }

  .hero-image-wrap {
    justify-self: end;
    width: 100%;
    max-width: 22rem;
  }

  .hero-image {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  /* ============ Shared section rhythm ============ */
  .section {
    padding-block: clamp(3rem, 2.2rem + 3vw, 5.5rem);
    border-top: 1px solid var(--color-border);
  }

  .section-narrow {
    max-width: 56rem;
  }

  .section :global(.section-heading) {
    margin-bottom: 2rem;
  }

  /* ============ Riscos ============ */
  .problem-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    font-size: 1.0625rem;
    color: var(--color-text);
  }

  .problem-list li {
    padding-left: 1.25rem;
    position: relative;
  }

  .problem-list li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-secondary);
  }

  .problem-close {
    margin-top: 1.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
  }

  /* ============ O que protegemos ============ */
  .scope-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .scope-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 2rem;
    }
  }

  .scope-group h3 {
    margin-bottom: 0.5rem;
  }

  .scope-group p {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  /* ============ Medidas de segurança (check-list) ============ */
  .check-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .check-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .check-list :global(svg) {
    color: var(--color-amber-hover);
    margin-top: 0.2rem;
    flex-shrink: 0;
  }

  /* ============ Prevenção, deteção, resposta ============ */
  .triad-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .triad-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .triad-block {
    padding-top: 1rem;
    border-top: 2px solid var(--color-amber);
  }

  .triad-block h3 {
    margin-bottom: 0.5rem;
  }

  .triad-block p {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  /* ============ Statement sections ============ */
  .statement-body {
    color: var(--color-muted);
    max-width: var(--container-prose);
  }

  /* ============ Pontual ou avença ============ */
  .modes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .modes-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  .mode-block h3 {
    margin-bottom: 0.5rem;
  }

  .mode-block p {
    color: var(--color-muted);
  }

  .mode-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-graphite);
    transition: gap var(--duration-base) var(--ease-standard);
  }

  .mode-link:hover {
    gap: 0.625rem;
    color: var(--color-amber-hover);
  }

  /* ============ FAQ ============ */
  .faq-close {
    margin-top: 1.5rem;
    color: var(--color-muted);
  }

  .faq-close-link {
    color: var(--color-graphite);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .faq-close-link:hover {
    color: var(--color-amber-hover);
  }

  /* ============ CTA final ============ */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    text-align: left;
  }

  .contact-form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.125rem;
  }

  @media (min-width: 640px) {
    .contact-form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-form :global(.form-label) {
    color: var(--color-surface);
  }

  .contact-form :global(.form-hint) {
    color: color-mix(in srgb, var(--color-surface) 65%, transparent);
  }
</style>
