---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Icon from "../../components/Icon.astro";
import FaqItem from "../../components/FaqItem.astro";
import CtaSection from "../../components/CtaSection.astro";
import FormGroup from "../../components/form/FormGroup.astro";
import Input from "../../components/form/Input.astro";
import Textarea from "../../components/form/Textarea.astro";
import notebookImage from "../../assets/images/office/notebook-planning-desk.jpg";

const questions = [
  "Vale a pena investir nisto agora, ou pode esperar?",
  "Este fornecedor está a oferecer o que a minha empresa precisa, ou só o que é mais fácil de vender?",
  "Se a empresa crescer, a nossa tecnologia atual aguenta?",
  "Estamos a pagar por ferramentas que já não usamos?",
];

const scopeGroups = [
  { title: "Avaliação da situação atual", description: "O que tem hoje, o que funciona e o que não funciona." },
  { title: "Planeamento de investimento", description: "O que faz sentido priorizar, e quando." },
  { title: "Escolha de equipamento e software", description: "Recomendações ajustadas à sua empresa, não a uma marca ou produto específico." },
  { title: "Acompanhamento de projetos", description: "Apoio na implementação de mudanças maiores, como trocar de sistema ou fornecedor." },
];

const steps = [
  { title: "Conversamos", description: "Sobre a situação atual e os planos da empresa." },
  { title: "Avaliamos as opções", description: "O que existe, o que custa, o que faz sentido." },
  { title: "Recomendamos um caminho", description: "Claro, sem jargão, com as alternativas explicadas." },
  { title: "Acompanhamos a decisão", description: "Até estar implementada, se for esse o pedido." },
];

const faqs = [
  { question: "Isto é só para empresas grandes com orçamentos grandes?", answer: "Não — é sobretudo útil para empresas pequenas, que não têm uma equipa de IT interna para avaliar estas decisões sozinhas." },
  { question: "Vão tentar vender-me equipamento ou software específico?", answer: "O nosso objetivo é recomendar o que faz sentido para a sua empresa, não empurrar uma marca ou produto específico." },
  { question: "Preciso de ter um problema para vos contactar?", answer: "Não — pode contactar-nos em qualquer altura. Muitas vezes o maior valor está precisamente em planear antes de haver um problema." },
  { question: "Quanto tempo demora uma avaliação?", answer: "Depende da complexidade da situação — definimos isso consigo depois de perceber o que precisa de ser avaliado." },
  { question: "Também acompanham a implementação, ou só dão a recomendação?", answer: "As duas opções existem — pode ficar só com a recomendação, ou pedir-nos para acompanhar a implementação até estar concluída." },
];
---

<BaseLayout
  title="Consultoria IT para Empresas"
  description="Avaliação, planeamento e recomendações tecnológicas para a sua empresa — decisões certas, sem jargão nem venda de tecnologia pela tecnologia."
>
  <section class="hero">
    <div class="container-content hero-layout">
      <div class="hero-text">
        <a href="/servicos" class="breadcrumb">Serviços</a>
        <h1>Decisões tecnológicas certas, sem ter de perceber de tecnologia.</h1>
        <p class="hero-sub body-lg">
          Ajudamos a sua empresa a decidir onde investir, o que mudar e o que evitar — sem venda de tecnologia
          pela tecnologia.
        </p>
        <div class="hero-actions">
          <Button href="#contacto" variant="primary">Marcar uma conversa</Button>
          <Button href="#o-que-tratamos" variant="secondary">Ver o que tratamos</Button>
        </div>
      </div>
      <div class="hero-image-wrap">
        <Image
          src={notebookImage}
          alt="Caderno com notas e esquemas simples, ao lado de um portátil, numa secretária de madeira."
          class="hero-image"
          widths={[350, 500, 700]}
          sizes="(min-width: 1024px) 22rem, (min-width: 768px) 30vw, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="As perguntas que já se deve ter feito." />
      <ul class="problem-list">
        {questions.map((q) => <li>{q}</li>)}
      </ul>
      <p class="problem-close">Não precisa de saber a resposta sozinho.</p>
    </div>
  </section>

  <section class="section" id="o-que-tratamos">
    <div class="container-content">
      <SectionHeading heading="O que tratamos." />
      <div class="scope-grid">
        {
          scopeGroups.map((g) => (
            <div class="scope-group">
              <h3>{g.title}</h3>
              <p>{g.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="Como funciona." />
      <ol class="steps-list">
        {
          steps.map((s, i) => (
            <li>
              <span class="steps-number">{String(i + 1).padStart(2, "0")}</span>
              <span>
                <strong>{s.title}</strong> — {s.description}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="Pontual ou acompanhamento contínuo." />
      <div class="modes-grid">
        <div class="mode-block">
          <h3>Pontual</h3>
          <p>Uma avaliação ou recomendação específica, sem compromisso continuado.</p>
        </div>
        <div class="mode-block">
          <h3>Avença</h3>
          <p>Acompanhamento tecnológico contínuo, para as decisões certas serem tomadas antes de se tornarem urgentes.</p>
        </div>
      </div>
      <a href="/solucoes" class="mode-link">
        Conhecer a avença
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="Perguntas frequentes." />
      <div class="faq-list">
        {
          faqs.map((f) => (
            <FaqItem question={f.question}>
              <p>{f.answer}</p>
            </FaqItem>
          ))
        }
      </div>
      <p class="faq-close">
        Ainda tem dúvidas? <a href="#contacto" class="faq-close-link">Fale connosco</a>.
      </p>
    </div>
  </section>

  <section id="contacto">
    <CtaSection subheading="Descreva a sua situação atual — remoto em todo o país, presencial na Grande Lisboa e Margem Sul do Tejo." tone="graphite">
      <Fragment slot="heading">Vamos planear os próximos passos.</Fragment>
      <form class="contact-form" method="post">
        <div class="contact-form-row">
          <FormGroup label="Nome" for="k-name" required>
            <Input id="k-name" name="name" required />
          </FormGroup>
          <FormGroup label="Empresa" for="k-company" required>
            <Input id="k-company" name="company" required />
          </FormGroup>
        </div>
        <div class="contact-form-row">
          <FormGroup label="Email" for="k-email" required>
            <Input id="k-email" name="email" type="email" required />
          </FormGroup>
          <FormGroup label="Telefone" for="k-phone">
            <Input id="k-phone" name="phone" type="tel" />
          </FormGroup>
        </div>
        <FormGroup label="Mensagem" for="k-message">
          <Textarea id="k-message" name="message" rows={4} />
        </FormGroup>
        <Button type="submit" variant="primary">Fale connosco</Button>
      </form>
    </CtaSection>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(3rem, 2.2rem + 3vw, 5.5rem); }
  .hero-layout { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
  @media (min-width: 768px) { .hero-layout { grid-template-columns: 1.6fr 1fr; gap: 3.5rem; } }
  @media (min-width: 1024px) { .hero-layout { grid-template-columns: 2fr 1fr; } }
  .hero-text { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; max-width: 40rem; }
  .breadcrumb { font-family: var(--font-body); font-weight: 600; font-size: 0.8125rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-muted); }
  .breadcrumb:hover { color: var(--color-amber-hover); }
  .hero-sub { color: var(--color-muted); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.875rem; margin-top: 0.5rem; }
  .hero-image-wrap { justify-self: end; width: 100%; max-width: 22rem; }
  .hero-image { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-md); }

  .section { padding-block: clamp(3rem, 2.2rem + 3vw, 5.5rem); border-top: 1px solid var(--color-border); }
  .section-narrow { max-width: 56rem; }
  .section :global(.section-heading) { margin-bottom: 2rem; }

  .problem-list { display: flex; flex-direction: column; gap: 0.875rem; font-size: 1.0625rem; color: var(--color-text); }
  .problem-list li { padding-left: 1.25rem; position: relative; }
  .problem-list li::before { content: "—"; position: absolute; left: 0; color: var(--color-secondary); }
  .problem-close { margin-top: 1.5rem; font-family: var(--font-heading); font-weight: 700; font-size: 1.125rem; }

  .scope-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  @media (min-width: 640px) { .scope-grid { grid-template-columns: 1fr 1fr; gap: 2.5rem 2rem; } }
  .scope-group h3 { margin-bottom: 0.5rem; }
  .scope-group p { color: var(--color-muted); font-size: 0.9375rem; }

  .steps-list { display: flex; flex-direction: column; gap: 1.25rem; }
  .steps-list li { display: flex; gap: 1rem; align-items: baseline; }
  .steps-number { font-family: ui-monospace, "SFMono-Regular", Consolas, monospace; font-size: 0.875rem; color: var(--color-amber-hover); flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .steps-list strong { font-family: var(--font-heading); }

  .modes-grid { display: grid; grid-template-columns: 1fr; gap: 1.75rem; margin-bottom: 1.5rem; }
  @media (min-width: 640px) { .modes-grid { grid-template-columns: 1fr 1fr; gap: 2.5rem; } }
  .mode-block h3 { margin-bottom: 0.5rem; }
  .mode-block p { color: var(--color-muted); }
  .mode-link { display: inline-flex; align-items: center; gap: 0.375rem; font-family: var(--font-heading); font-weight: 600; font-size: 0.9375rem; color: var(--color-graphite); transition: gap var(--duration-base) var(--ease-standard); }
  .mode-link:hover { gap: 0.625rem; color: var(--color-amber-hover); }

  .faq-close { margin-top: 1.5rem; color: var(--color-muted); }
  .faq-close-link { color: var(--color-graphite); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .faq-close-link:hover { color: var(--color-amber-hover); }

  .contact-form { display: flex; flex-direction: column; gap: 1.125rem; text-align: left; }
  .contact-form-row { display: grid; grid-template-columns: 1fr; gap: 1.125rem; }
  @media (min-width: 640px) { .contact-form-row { grid-template-columns: 1fr 1fr; } }
  .contact-form :global(.form-label) { color: var(--color-surface); }
  .contact-form :global(.form-hint) { color: color-mix(in srgb, var(--color-surface) 65%, transparent); }
</style>
