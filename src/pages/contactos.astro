---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";
import CtaSection from "../components/CtaSection.astro";
import FormGroup from "../components/form/FormGroup.astro";
import Input from "../components/form/Input.astro";
import Textarea from "../components/form/Textarea.astro";

const CONTACT_EMAIL = "solveit.email@gmail.com";
---

<BaseLayout
  title="Contactos"
  description="Fale com a SolveIT sobre a informática da sua empresa — preencha o formulário ou escreva diretamente para solveit.email@gmail.com."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container-content hero-text">
      <p class="label">Contactos</p>
      <h1>Vamos falar sobre a sua informática.</h1>
      <p class="hero-sub body-lg">
        Conte-nos o que está a acontecer ou o que precisa de melhorar. Respondemos para perceber a sua situação e
        indicar o próximo passo.
      </p>
    </div>
  </section>

  <!-- Formulário -->
  <section class="section" id="formulario">
    <div class="container-content section-narrow">
      <div class="form-card">
        <form id="contact-form" novalidate>
          <div class="contact-form-row">
            <FormGroup label="Nome" for="c-name" required>
              <Input id="c-name" name="name" required />
            </FormGroup>
            <FormGroup label="Empresa" for="c-company" required>
              <Input id="c-company" name="company" required />
            </FormGroup>
          </div>
          <div class="contact-form-row">
            <FormGroup label="Email" for="c-email" required>
              <Input id="c-email" name="email" type="email" required />
            </FormGroup>
            <FormGroup label="Telefone" for="c-phone" hint="Opcional">
              <Input id="c-phone" name="phone" type="tel" aria-describedby="c-phone-hint" />
            </FormGroup>
          </div>
          <FormGroup label="Mensagem" for="c-message" required>
            <Textarea id="c-message" name="message" rows={5} required />
          </FormGroup>

          <!-- Honeypot anti-spam — campo invisível; bots costumam preenchê-lo, humanos nunca o veem -->
          <div class="honeypot" aria-hidden="true">
            <label for="c-botcheck">Não preencher este campo</label>
            <input type="checkbox" id="c-botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form-footer">
            <p id="form-status" class="form-status" role="status" aria-live="polite" hidden></p>
            <Button type="submit" variant="primary" class="form-submit">Enviar pedido</Button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Contacto direto -->
  <section class="section">
    <div class="container-content section-narrow">
      <SectionHeading heading="Prefere escrever diretamente?" />
      <div class="direct-contact">
        <a href={`mailto:${CONTACT_EMAIL}`} class="direct-contact-email">
          <Icon name="mail" size={20} />
          {CONTACT_EMAIL}
        </a>
        <Button href={`mailto:${CONTACT_EMAIL}`} variant="secondary">Enviar email</Button>
      </div>
    </div>
  </section>

  <!-- Expectativas -->
  <section class="section">
    <div class="container-content section-narrow">
      <div class="expectations-note">
        <Icon name="check" size={20} class="expectations-icon" />
        <p>
          Não precisa de saber explicar o problema tecnicamente. Diga-nos simplesmente o que está a acontecer —
          nós ajudamos a perceber o resto.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <CtaSection
    heading="Tem uma questão sobre a informática da sua empresa?"
    subheading="Fale connosco."
    primaryLabel="Preencher o formulário"
    primaryHref="#formulario"
    tone="graphite"
  />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 2.2rem + 3vw, 5.5rem);
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 42rem;
  }

  .hero-sub {
    color: var(--color-muted);
  }

  .section {
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem);
    border-top: 1px solid var(--color-border);
  }

  .section-narrow {
    max-width: 42rem;
  }

  .section :global(.section-heading) {
    margin-bottom: 1.5rem;
  }

  /* Formulário */
  .form-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 1.25rem + 1.2vw, 2.5rem);
  }

  #contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 560px) {
    .contact-form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .form-footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .form-status {
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-sm);
  }

  .form-status[data-tone="success"] {
    background: color-mix(in srgb, #2f7a4d 12%, transparent);
    color: #205c38;
  }

  .form-status[data-tone="error"] {
    background: var(--color-error-bg);
    color: var(--color-error);
  }

  .form-submit {
    align-self: flex-start;
  }

  .form-submit[disabled] {
    opacity: 0.6;
    cursor: wait;
  }

  /* Contacto direto */
  .direct-contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .direct-contact-email {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--color-graphite);
  }

  .direct-contact-email:hover {
    color: var(--color-amber-hover);
  }

  /* Expectativas */
  .expectations-note {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    background: var(--color-amber-tint);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.375rem;
  }

  .expectations-note :global(.expectations-icon) {
    color: var(--color-amber-hover);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .expectations-note p {
    color: var(--color-text);
    font-size: 1rem;
  }

  /* Erros de campo criados dinamicamente pelo script — mesma aparência do FormGroup.astro */
  :global(.form-error) {
    font-size: 0.8125rem;
    color: var(--color-error);
    font-weight: 500;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const statusEl = document.querySelector<HTMLParagraphElement>("#form-status");
  const submitBtn = form?.querySelector<HTMLButtonElement>(".form-submit");

  const ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;

  const REQUIRED_FIELDS: Record<string, string> = {
    name: "Indique o seu nome.",
    company: "Indique o nome da empresa.",
    email: "Indique um email válido.",
    message: "Escreva uma mensagem.",
  };

  function fieldEl(name: string) {
    return form?.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`) ?? null;
  }

  function clearFieldError(input: HTMLInputElement | HTMLTextAreaElement) {
    input.classList.remove("field--invalid");
    input.removeAttribute("aria-invalid");
    const existing = document.getElementById(`${input.id}-error`);
    existing?.remove();
  }

  function setFieldError(input: HTMLInputElement | HTMLTextAreaElement, message: string) {
    input.classList.add("field--invalid");
    input.setAttribute("aria-invalid", "true");

    let errorEl = document.getElementById(`${input.id}-error`) as HTMLParagraphElement | null;
    if (!errorEl) {
      errorEl = document.createElement("p");
      errorEl.id = `${input.id}-error`;
      errorEl.className = "form-error";
      errorEl.setAttribute("role", "alert");
      input.insertAdjacentElement("afterend", errorEl);
    }
    errorEl.textContent = message;
    input.setAttribute("aria-describedby", errorEl.id);
  }

  function showStatus(message: string, tone: "success" | "error") {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.dataset.tone = tone;
    statusEl.hidden = false;
  }

  function hideStatus() {
    if (!statusEl) return;
    statusEl.hidden = true;
    statusEl.textContent = "";
    delete statusEl.dataset.tone;
  }

  function validate(): boolean {
    let firstInvalid: HTMLElement | null = null;

    for (const [name, message] of Object.entries(REQUIRED_FIELDS)) {
      const input = fieldEl(name);
      if (!input) continue;

      const isEmail = name === "email";
      const value = input.value.trim();
      const valid = isEmail ? input.checkValidity() && value.length > 0 : value.length > 0;

      if (valid) {
        clearFieldError(input);
      } else {
        setFieldError(input, message);
        firstInvalid ??= input;
      }
    }

    firstInvalid?.focus();
    return !firstInvalid;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    hideStatus();

    if (!validate()) {
      showStatus("Verifique os campos assinalados abaixo.", "error");
      return;
    }

    const botcheck = form.querySelector<HTMLInputElement>('[name="botcheck"]');
    if (botcheck?.checked) {
      // Silently drop — a real visitor never checks a hidden field.
      return;
    }

    const payload = {
      access_key: ACCESS_KEY,
      subject: "Novo pedido de contacto — SolveIT",
      from_name: "Site SolveIT",
      name: (fieldEl("name") as HTMLInputElement)?.value.trim(),
      company: (fieldEl("company") as HTMLInputElement)?.value.trim(),
      email: (fieldEl("email") as HTMLInputElement)?.value.trim(),
      phone: (fieldEl("phone") as HTMLInputElement)?.value.trim(),
      message: (fieldEl("message") as HTMLTextAreaElement)?.value.trim(),
    };

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "A enviar...";
    }

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await response.json();

      if (result.success) {
        form.reset();
        showStatus("Pedido enviado. Vamos responder assim que possível.", "success");
      } else {
        showStatus(
          `Não foi possível enviar o pedido. Tente novamente ou escreva para ${"solveit.email@gmail.com"}.`,
          "error",
        );
      }
    } catch {
      showStatus(
        "Não foi possível enviar o pedido — verifique a sua ligação. Pode também escrever para solveit.email@gmail.com.",
        "error",
      );
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Enviar pedido";
      }
    }
  });
</script>
